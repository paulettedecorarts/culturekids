# ┌─────────────────────────────────────────────────────────────┐
# │                     APPLICATION                             │
# └─────────────────────────────────────────────────────────────┘
APP_NAME="Paulette Culture Kids"
APP_ENV=production
APP_KEY=                        # ← run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com  # ← your domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ┌─────────────────────────────────────────────────────────────┐
# │                      LOGGING                                │
# └─────────────────────────────────────────────────────────────┘
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ┌─────────────────────────────────────────────────────────────┐
# │                      DATABASE                               │
# │  In Docker/Coolify these are set automatically.             │
# │  Only change if you're connecting to an external DB.        │
# └─────────────────────────────────────────────────────────────┘
DB_CONNECTION=mysql
# Local dev (php artisan serve on host + docker-compose.dev.yml):
DB_HOST=127.0.0.1
DB_PORT=3307
# Inside full Docker stack only: DB_HOST=mysql, DB_PORT=3306
DB_DATABASE=paulette
DB_USERNAME=paulette
DB_PASSWORD=PauletteKwatagig2024

# ┌─────────────────────────────────────────────────────────────┐
# │                       REDIS                                 │
# │  Local dev: 127.0.0.1:6380 (docker-compose.dev.yml)         │
# │  Docker app container: redis:6379                           │
# └─────────────────────────────────────────────────────────────┘
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# ┌─────────────────────────────────────────────────────────────┐
# │                    SESSION / CACHE / QUEUE                  │
# └─────────────────────────────────────────────────────────────┘
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=database

# Docker only: run full heritage seed on container start (first deploy). Leave false after that.
# RUN_DB_SEED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ┌─────────────────────────────────────────────────────────────┐
# │                        MAIL  ← SET THESE                   │
# └─────────────────────────────────────────────────────────────┘
MAIL_MAILER=smtp               # ← smtp | ses | mailgun | postmark
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.yourmailprovider.com  # ← e.g. smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=                 # ← your SMTP username
MAIL_PASSWORD=                 # ← your SMTP password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ┌─────────────────────────────────────────────────────────────┐
# │                         AWS (optional)                      │
# └─────────────────────────────────────────────────────────────┘
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ┌─────────────────────────────────────────────────────────────┐
# │                  PUSH NOTIFICATIONS (mobile)                │
# │  Expo tokens from the app → Expo Push API (no FCM key needed) │
# └─────────────────────────────────────────────────────────────┘
PUSH_PROVIDER=expo
# PUSH_PROVIDER=log
# PUSH_PROVIDER=fcm
# PUSH_PROVIDER=composite

# Only required for fcm or composite providers:
PUSH_FCM_URL=https://fcm.googleapis.com/fcm/send
PUSH_FCM_SERVER_KEY=
